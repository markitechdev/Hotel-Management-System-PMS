APP_NAME="Hotel PMS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cloud PostgreSQL (Supabase, Neon, Render Postgres...).
# Paste the full connection string into DB_URL; it overrides the individual DB_* values.
# For Supabase on Render, use the "Session pooler" string (Render cannot reach the IPv6-only direct host).
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

# Quick local setup without Postgres: set DB_CONNECTION=sqlite, leave DB_URL empty,
# and create the file with: touch database/database.sqlite

# Websites allowed to call the API (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
